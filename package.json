{
  "name": "skillspace",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "db:seed": "node --env-file-if-exists=.env server/seed.js",
    "db:migrate:test": "node --env-file=.env.test server/migrate.js",
    "db:seed:test": "node --env-file=.env.test server/seed.js",
    "test:integration": "node --env-file=.env.test --test server/integration.test.js",
    "test:api": "node --test server/app.test.js server/http.test.js server/security.test.js"
  },
  "engines": { "node": ">=22.12.0" },
  "dependencies": {
    "pg": "^8.16.3"
  },
  "devDependencies": { "vite": "latest" }
}